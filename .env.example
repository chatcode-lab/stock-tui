# Generate Paper Trading credentials at https://app.alpaca.markets/ .
# The secret is shown once. Interactive onboarding can store both values under
# the platform config directory; fill a private `.env` only when overriding it.
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Optional overrides
# STOCK_TUI_PROVIDER=alpaca
# STOCK_TUI_STOCK_API_URL=https://stock.chatcode.dev/api
# STOCK_TUI_STOCK_API_NEWS=true
# STOCK_TUI_FEED=iex
# STOCK_TUI_REFRESH_SECONDS=300
# STOCK_TUI_DB_PATH=/absolute/path/to/stock-tui.db
# STOCK_TUI_CATALOG_URL=https://stock.chatcode.dev/catalog/sec-catalog.json
# STOCK_TUI_CATALOG_REFRESH_HOURS=12
